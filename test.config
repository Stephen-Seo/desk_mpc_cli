# string to pass to --host=<string> for mpc
mpc_host = my_mpd_password@127.0.0.1
# the user to allow
user = testuser
# the password
password = testpassword
# what address/port for this server to listen on
address_port = 127.0.0.1:8080

# another user to allow
user = anotheruser
# password for anotheruser
password = anotherpassword
